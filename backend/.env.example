# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=healthcare_db

# Security & Authentication
JWT_SECRET=super_secure_healthcare_jwt_secret_key_2026_xyz
JWT_EXPIRES_IN=7d

# Frontend URL for CORS
FRONTEND_URL=http://localhost:5173

# Optional AI Integration (Leave empty to use intelligent built-in rule-based clinical engine)
GEMINI_API_KEY=
OPENAI_API_KEY=

# Optional Notification Provider (Email / SMS)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
